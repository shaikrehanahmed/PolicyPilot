# ==========================================
# POLICYPILOT ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure local values
# DO NOT COMMIT REAL SECRETS OR KEYS TO GIT
# ==========================================

# Application Environment (local | demo | production)
ENVIRONMENT=local
DEBUG=true

# Database Connection (PostgreSQL 16 with pgvector)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/policypilot
# Supabase/Cloud: postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policypilot

# Symmetric Encryption Key for User Profiles (Generate 32-byte hex or base64)
APP_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production

# LLM Gateway Configuration (gemini | anthropic)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector Embedding Configuration
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# Demo & Ingestion Flags
DEMO_MODE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DEMO_MODE=true

# Security & Network
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
