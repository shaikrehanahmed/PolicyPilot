# =============================================================================
# PolicyPilot Environment Configuration Template
# Copy to services/api/.env and apps/web/.env.local
# NEVER commit real secrets or live API keys to Git.
# =============================================================================

# --- Application & Runtime ---
APP_NAME=PolicyPilot API
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# --- CORS & Frontend URLs ---
CORS_ORIGINS=["http://localhost:3000","https://policy-pilot-pi.vercel.app"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Authentication & Admin Pricing Control (Server-Side Only) ---
AUTH_SECRET_KEY=your_hmac_session_secret_placeholder_here
ADMIN_API_KEY=your_protected_admin_pricing_key_placeholder_here

# --- Razorpay Payment & Webhook Security (Server-Side Secrets) ---
# Leave as placeholders in development to use verified sandbox test-signature mode.
RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder

# --- Default Subscription Pricing (Integer Paise: 1900 = ₹19.00/month) ---
DEFAULT_INDIVIDUAL_PRICE_PAISE=1900
DEFAULT_ORG_DISCOUNT_PERCENT=25
FREE_SUCCESSFUL_ANALYSES_LIMIT=2

# --- Google Gemini AI & Cloud TTS (Optional in Demo Mode) ---
GEMINI_API_KEY=your_gemini_api_key_placeholder_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_placeholder_here
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID_EN=your_verified_english_voice_id_placeholder
ELEVENLABS_VOICE_ID_TE=your_verified_telugu_voice_id_placeholder
ELEVENLABS_VOICE_ID_HI=your_verified_hindi_voice_id_placeholder
ELEVENLABS_VOICE_ID_UR=your_verified_urdu_voice_id_placeholder

# --- PostgreSQL & Scheduled Monitoring ---
DATABASE_URL=postgresql+asyncpg://postgres:password_placeholder@localhost:5432/policypilot
ANNOUNCEMENT_CRON_ENABLED=false
ANNOUNCEMENT_CHECK_INTERVAL_MINUTES=360
