# =============================================================================
# PolicyPilot Environment Configuration Template
# Copy this file to .env (root or services/api/.env) and apps/web/.env.local
# NEVER commit real API keys or secrets to version control.
# =============================================================================

# --- Application & Runtime ---
APP_NAME=PolicyPilot API
APP_VERSION=0.3.0
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# --- CORS & Frontend Integration ---
CORS_ORIGINS=["http://localhost:3000","https://policy-pilot-pi.vercel.app"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Google Gemini AI Configuration (Optional in Demo Mode) ---
# Used by /api/v1/assistant/chat and /api/v1/workflow/run when configured.
# Automatically falls back to deterministic rules + localized dictionaries on quota exhaustion.
GEMINI_API_KEY=your_gemini_api_key_placeholder_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIM=768

# --- Cloud Text-to-Speech Configuration (Server-Side Only — Never Expose in NEXT_PUBLIC_*) ---
# Supported values for TTS_PROVIDER: elevenlabs | browser_fallback
# IMPORTANT: Use eleven_v3 for Telugu (te) and Urdu (ur) support on ElevenLabs.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_placeholder_here
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID_EN=your_verified_english_voice_id_placeholder
ELEVENLABS_VOICE_ID_TE=your_verified_telugu_voice_id_placeholder
ELEVENLABS_VOICE_ID_HI=your_verified_hindi_voice_id_placeholder
ELEVENLABS_VOICE_ID_UR=your_verified_urdu_voice_id_placeholder

# --- PostgreSQL & pgvector Configuration (Optional in Demo Mode) ---
DATABASE_URL=postgresql+asyncpg://postgres:password_placeholder@localhost:5432/policypilot

# --- Official Scheme Announcements Scheduler Configuration ---
ANNOUNCEMENT_CRON_ENABLED=false
ANNOUNCEMENT_CHECK_INTERVAL_MINUTES=360
